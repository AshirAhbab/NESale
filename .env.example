# PostgreSQL Database Connection String for Supabase
# Port 6543 is for the pooled connection (app runtime)
# Port 5432 is for direct connection (Prisma migrations & schema push)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"

# Supabase Client SDK
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="[YOUR_SUPABASE_ANON_KEY]"

# Google Gemini API Key (kept for backward-compatible deterministic fallback)
GEMINI_API_KEY=""

# ============================================
# Embedding Configuration (RAG / Knowledge Base)
# ============================================
# Embedding provider: "gemini" or "none" (deterministic hash fallback)
EMBEDDING_PROVIDER="gemini"

# Gemini embedding model (text-embedding-004 produces 768-dim vectors)
EMBEDDING_MODEL="text-embedding-004"

# Vector dimensions (must match the model output: text-embedding-004 = 768)
EMBEDDING_DIMENSIONS="768"

# When "true", fail instead of silently falling back to deterministic hash embeddings.
# Set to "true" in production to avoid silent model mismatch.
EMBEDDING_REJECT_FALLBACK="false"

# ============================================
# OpenRouter AI Integration (Free Models Only)
# ============================================
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# OpenRouter API base URL (do not change unless self-hosting)
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# Model routing: "openrouter/free" for dynamic free-model selection,
# or a comma-separated list of specific free model IDs (e.g. "moonshotai/kimi-free,meta-llama/llama-3.2-3b-instruct:free")
OPENROUTER_MODELS="openrouter/free"

# Restrict to free models only. Never falls back to paid models.
OPENROUTER_FREE_ONLY="true"

# Request timeout in milliseconds
OPENROUTER_TIMEOUT_MS="20000"

# Maximum retry attempts for transient failures (429, 5xx, timeouts)
OPENROUTER_MAX_RETRIES="1"

# Optional: Your application URL for OpenRouter referer header
OPENROUTER_APP_URL="https://nesale.local"
